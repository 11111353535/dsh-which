{
  "name": "dsh-which",
  "version": "0.1.0",
  "description": "Command resolution forensics for DeepSeek Harness: what actually runs when a command is typed 鈥?which PATH entry wins, what it shadowed, what shape PATH is in, and whether the copies behind one name agree on a version.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "scripts"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:live": "node test/live-which.mjs",
    "setup:deps": "node scripts/link-host-deps.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "which",
    "path",
    "pathext",
    "command-resolution",
    "shadowing",
    "environment",
    "diagnostics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/11111353535/dsh-which.git"
  },
  "homepage": "https://github.com/11111353535/dsh-which#readme",
  "bugs": {
    "url": "https://github.com/11111353535/dsh-which/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT"
}
